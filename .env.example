HANDOFF_LISTEN_ADDR=127.0.0.1:7391
HANDOFF_DATA_DIR=/var/lib/handoff
HANDOFF_PUBLIC_URL=https://handoff.example.com
HANDOFF_API_TOKEN=replace-with-a-long-random-token
HANDOFF_DEFAULT_TTL=168h
HANDOFF_MAX_TTL=720h

# Optional: only required for `handoff create --compact server`.
# Use an Agent Plan key; ModelArk and Coding Plan keys are not interchangeable.
# ARK_AGENT_PLAN_BASE_URL=https://ark.cn-beijing.volces.com/api/plan
# ARK_AGENT_PLAN_API_KEY=replace-with-your-agent-plan-api-key
# ARK_AGENT_PLAN_MODEL=kimi-k3
